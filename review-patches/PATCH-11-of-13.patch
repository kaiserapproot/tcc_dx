+++ b/dev/test/a9/negative/local_static_dtor.cpp
@@ -0,0 +1,15 @@
+struct S {
+    S() {}
+    ~S() {}
+};
+
+void f()
+{
+    static S s;
+}
+
+int main()
+{
+    f();
+    return 0;
+}
